# ---------------------------------------------------------------------------
# Model / llama-swap configuration
# ---------------------------------------------------------------------------
# Hugging Face GGUF repo and the quant pattern to download
MODEL_REPO=unsloth/gemma-4-12b-it-GGUF
MODEL_QUANT=UD-Q4_K_XL
# Internal id used for the llama-swap model name and the opencode model
MODEL_ID=gemma4-12b
# Optional Hugging Face token (needed for gated/private repos)
HF_TOKEN=

# Inference parameters
CTX_SIZE=262144
N_PREDICT=8192
KV_CACHE_TYPE=q8_0
MODEL_TTL=900
TEMP=0.7
TOP_P=0.95
TOP_K=64
# Reasoning effort advertised to opencode for the model (low | medium | high)
REASONING_EFFORT=high

# Rewrite ~/.config/opencode/opencode.json on every container start so changes
# to the variables above take effect. Any manual edits to that file are lost.
# Leave false to generate it only when it does not exist.
REGENERATE_OPENCODE_CONFIG=false

# API key that protects the llama-swap endpoint (also used by opencode).
# Leave empty to disable authentication.
LLAMA_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# User / runtime
# ---------------------------------------------------------------------------
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Extra OS packages to install into the opencode container at boot (Debian apt,
# space-separated). Installed by entrypoint.sh before sshd starts. Leave empty
# to install nothing. Example: APT_PACKAGES="vim tmux ripgrep"
APT_PACKAGES=

# Root-run init hook, executed by entrypoint.sh before sshd starts. The image
# ships no sudo, so this is how you make root-level tweaks (config files,
# services, anything APT_PACKAGES cannot express). The container path below is
# what gets executed; it is skipped if the file does not exist, and refused if
# it is writable by the unprivileged 'user' account.
INIT_SCRIPT=/opt/init/init.sh

# Internal URL opencode uses to reach llama-swap (compose service name)
LLAMA_SWAP_URL=http://llama-swap:8080

# AMD/ROCm only: force the gfx target for GPUs not in the official ROCm support
# list (common for consumer RDNA cards). Leave commented for NVIDIA.
# gfx1100 -> 11.0.0, gfx1030 -> 10.3.0, etc.
#HSA_OVERRIDE_GFX_VERSION=11.0.0

# ---------------------------------------------------------------------------
# Host paths
# ---------------------------------------------------------------------------
# Where the interactive user's home directory is persisted on the host
USER_HOME_PATH=/home/docker/opencode
# Host directory mounted read-only at /opt/init, holding the init.sh hook above.
# Keep it owned by root and outside USER_HOME_PATH, or the hook is refused.
INIT_PATH=./init
# Where downloaded models and the generated config live on the host
MODELS_PATH=/home/docker/llama-swap/models

# ---------------------------------------------------------------------------
# SSH access to the opencode container
# ---------------------------------------------------------------------------
# Host port mapped to the container's SSH (22). Set to 22 to expose it directly.
SSH_PORT=2222
# Authorized public key allowed to log in (user: "user")
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your_public_key_here
